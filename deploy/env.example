# /etc/karotto/env — read by the karotto systemd service and the karotto CLI.
NODE_ENV=production
DATABASE_URL=postgres://karotto:__DB_PASSWORD__@127.0.0.1:5432/karotto
HOST=127.0.0.1
PORT=3210
STATIC_DIR=/opt/karotto/src/packages/web/dist
# The app sits behind Cloudflare Tunnel or a reverse proxy that terminates TLS.
TRUST_PROXY=true
LOG_LEVEL=info
SESSION_TTL_DAYS=365
