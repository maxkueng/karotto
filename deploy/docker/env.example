# Copy to .env next to compose.yaml.

# Required. Anything long and random; only the two containers ever see it.
POSTGRES_PASSWORD=

# Port on the host. The app itself always listens on 3000 inside the container.
KAROTTO_PORT=3000

# Image tag: a release like 0.2.0, or latest. edge follows the master branch.
KAROTTO_VERSION=latest

# Set both to true when a reverse proxy (Caddy, Traefik, Tailscale Serve)
# terminates HTTPS in front of the app.
SECURE_COOKIES=false
TRUST_PROXY=false

LOG_LEVEL=info
