# /opt/karotto/docker/.env — written once by install.sh, read by docker compose.
COMPOSE_PROJECT_NAME=karotto
POSTGRES_PASSWORD=__DB_PASSWORD__
KAROTTO_VERSION=latest
KAROTTO_BIND=127.0.0.1
KAROTTO_PORT=3210
# Tailscale Serve terminates HTTPS in front of the app.
SECURE_COOKIES=true
TRUST_PROXY=true
LOG_LEVEL=info
SESSION_TTL_DAYS=365
