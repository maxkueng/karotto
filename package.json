{
  "name": "karotto",
  "version": "0.1.0",
  "private": true,
  "description": "Habit, daily and to-do tracker without the game",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @karotto/server\" \"npm run dev -w @karotto/web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages",
    "format": "eslint packages --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-solid": "^0.18.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
