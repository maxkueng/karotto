{
  "name": "@karotto/server",
  "version": "0.1.0",
  "description": "karotto API server",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-only",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli.ts migrate",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@karotto/core": "*",
    "@node-rs/argon2": "^2.2.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "luxon": "^3.7.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "yargs": "^18.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/luxon": "^3.7.5",
    "@types/yargs": "^17.0.35",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
