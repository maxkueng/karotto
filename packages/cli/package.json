{
  "name": "@karotto/cli",
  "version": "0.3.2",
  "description": "karotto: command-line client for the karotto API",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-only",
  "bin": {
    "karotto": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsup",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "build:standalone": "tsup --config tsup.standalone.config.ts && mv dist/standalone/karotto.js dist/standalone/karotto"
  },
  "dependencies": {
    "@karotto/core": "*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "yargs": "^18.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
